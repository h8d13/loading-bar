#!/bin/bash
url="$1"
output="${2:-$(basename "$url")}"

trap 'printf "\e]9;4;0;\e\\"' EXIT INT TERM

# Probe size via HEAD (follow redirects); some servers omit Content-Length.
size=$(curl -sIL "$url" | tr -d '\r' | awk 'tolower($1)=="content-length:"{v=$2} END{print v}')

if [[ -n "$size" && "$size" -gt 0 ]]; then
  curl -L --progress-bar -o "$output" "$url" 2>&1 | \
    stdbuf -o0 tr '\r' '\n' | \
    while IFS= read -r line; do
      if [[ "$line" =~ ([0-9]+)\.[0-9]+% ]]; then
        pct="${BASH_REMATCH[1]}"
        printf "\e]9;4;1;%d\e\\" "$pct"
        printf "\r%s" "$line" >&2
      fi
    done
  status="${PIPESTATUS[0]}"
else
  # Unknown size: indeterminate taskbar + curl's default byte/time meter.
  printf "\e]9;4;3;\e\\"
  curl -L -o "$output" "$url"
  status=$?
fi

echo

if [ "$status" -ne 0 ]; then
  printf "\e]9;4;2;100\e\\"
  sleep 0.5
  exit 1
fi
