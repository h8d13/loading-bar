#!/bin/bash
# usage: grel <url> [output]
# downloads a release asset, extracts, records source url.

url="$1"
out="${2:-$(basename "$url")}"

if [ -z "$url" ]; then
	echo "usage: $0 <url> [output]" >&2
	exit 2
fi

extract() {
	local archive="$1" src="$2" dir
	case "$archive" in
		*.tar.gz)  dir="${archive%.tar.gz}"  ;;
		*.tgz)     dir="${archive%.tgz}"     ;;
		*.tar.bz2) dir="${archive%.tar.bz2}" ;;
		*.tbz2)    dir="${archive%.tbz2}"    ;;
		*.tar.xz)  dir="${archive%.tar.xz}"  ;;
		*.txz)     dir="${archive%.txz}"     ;;
		*.tar)     dir="${archive%.tar}"     ;;
		*.zip)     dir="${archive%.zip}"     ;;
		*) return ;;
	esac
	mkdir -p "$dir" || return
	case "$archive" in
		*.zip) unzip -q "$archive" -d "$dir" ;;
		*)     tar -xf "$archive" -C "$dir" --strip-components=1 ;;
	esac && rm -- "$archive" && printf '%s\n' "$src" > "$dir/.source"
}

./curld "$url" "$out" || exit $?
extract "$out" "$url"
